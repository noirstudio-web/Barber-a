# Copia este archivo como .env (local) o crea estas variables en Vercel.

# Base de datos Postgres (Neon, Supabase...). Sin ella, en local se usa una base embebida en .data/
DATABASE_URL=

# Código maestro de Noir Studio: se pide para crear cuentas en /noir/registro.
# En local, si no se define, el código es "demo".
ADMIN_PASSWORD=
# Opcional: secreto para firmar la sesión (por defecto se deriva de ADMIN_PASSWORD)
SESSION_SECRET=

# Fotos que suben las barberías (Vercel Blob). En local se guardan en public/uploads
BLOB_READ_WRITE_TOKEN=

# WhatsApp de ventas de Noir Studio, con indicativo y sin "+" (botones de la página de venta)
NEXT_PUBLIC_NOIR_WHATSAPP=

# Clave con la que Vercel llama al cron de recordatorios (/api/cron/recordatorios)
CRON_SECRET=

# Opcional: avisos y recordatorios automáticos por la API de WhatsApp Cloud (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_IDIOMA=es
WHATSAPP_PLANTILLA=
WHATSAPP_PLANTILLA_RECORDATORIO_CLIENTE=
WHATSAPP_PLANTILLA_RECORDATORIO_BARBERO=
